# Telegram Bot Credentials (Get from https://t.me/BotFather and https://my.telegram.org)
TELEGRAM_BOT_TOKEN="your_bot_token_from_botfather"  # Provide your Telegram Bot Token
TELEGRAM_API_ID=12345678  # Provide your Telegram API ID
TELEGRAM_API_HASH="your_telegram_api_hash"  # Provide your Telegram API Hash

# Database Configuration (MongoDB)
MONGODB_URI="mongodb://localhost:27017"  # Provide your MongoDB connection URI
DATABASE_NAME="commitcast_bot"

# Polling Interval (in seconds)
POLL_INTERVAL_SECONDS=15

# Developer & Owner Settings
DEVELOPER_OWNER_ID=123456789  # Provide your Telegram User ID (e.g. from @userinfobot)
GITHUB_TOKEN=""  # Provide your optional GitHub personal access token
GITHUB_CLIENT_ID="your_github_oauth_client_id"  # Provide your GitHub OAuth App Client ID
GITHUB_WEBHOOK_SECRET=""  # Provide your optional GitHub Webhook secret
